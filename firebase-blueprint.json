{
  "entities": {
    "TeamMember": {
      "title": "TeamMember",
      "description": "Public team profile for a Go To Truckers closer (no PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "focus": {
          "type": "string",
          "maxLength": 80
        },
        "statusText": {
          "type": "string",
          "maxLength": 140
        },
        "dailyCalls": {
          "type": "integer",
          "description": "Number of calls this closer is getting per day (0-10000)."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 32000,
          "pattern": "^(|https://.*|data:image/(jpeg|png|webp);base64,.*)$",
          "description": "Optional profile picture (https URL or compressed JPEG/PNG/WebP data URI)."
        },
        "presenceState": {
          "type": "string",
          "enum": ["online", "busy", "afk", "offline"],
          "description": "Live connection/availability status of the closer."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last heartbeat timestamp proving active session."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "teamId", "displayName", "focus", "statusText", "dailyCalls", "createdAt", "updatedAt"]
    },
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private PII and personal notification preferences strictly accessible by the owning closer or admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "postNotificationsEnabled": {
          "type": "boolean",
          "description": "Whether to alert this closer when a new post is published."
        },
        "postSoundEnabled": {
          "type": "boolean",
          "description": "Whether to play a sound on new post alerts."
        },
        "postSoundTone": {
          "type": "string",
          "enum": ["chime", "ping", "soft"],
          "description": "Synthesized sound profile for new post alerts."
        },
        "postBrowserAlertsEnabled": {
          "type": "boolean",
          "description": "Whether to dispatch browser Notifications API alerts when permitted."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "TeamPost": {
      "title": "TeamPost",
      "description": "Shared team post with optional title and body.",
      "type": "object",
      "properties": {
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "category": {
          "type": "string",
          "enum": ["post", "message", "idea", "mql", "sql", "opening"]
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "body": {
          "type": "string",
          "maxLength": 4000,
          "description": "Post text body (required unless imageUrl is provided)."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^https://.*",
          "description": "Optional Cloudinary secure_url image attached to the post (or null when omitted)."
        },
        "lane": {
          "type": "string",
          "maxLength": 80
        },
        "equipment": {
          "type": "string",
          "enum": ["", "Dry Van", "Reefer", "Both"]
        },
        "loadsPerWeek": {
          "type": "string",
          "maxLength": 30
        },
        "stageStatus": {
          "type": "string",
          "enum": ["open", "in_progress", "won", "archived"]
        },
        "pinned": {
          "type": "boolean"
        },
        "replyCount": {
          "type": "integer"
        },
        "likeCount": {
          "type": "integer"
        },
        "lastCommentId": {
          "type": "string",
          "maxLength": 128
        },
        "marginNote": {
          "type": "object",
          "description": "Optional selective contextual margin note ({ points: string[] }) cached directly on the post document.",
          "properties": {
            "points": {
              "type": "array",
              "description": "1 to 3 concise margin note points for closers."
            }
          },
          "required": ["points"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "teamId",
        "authorId",
        "authorName",
        "category",
        "title",
        "body",
        "lane",
        "equipment",
        "loadsPerWeek",
        "stageStatus",
        "pinned",
        "replyCount",
        "likeCount",
        "lastCommentId",
        "createdAt",
        "updatedAt"
      ]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Reply or coaching note from a closer on a shared post.",
      "type": "object",
      "properties": {
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["teamId", "postId", "authorId", "authorName", "body", "createdAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Single closer reaction/like on a post.",
      "type": "object",
      "properties": {
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "postId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["teamId", "postId", "userId", "createdAt"]
    },
    "DirectThread": {
      "title": "DirectThread",
      "description": "Private 1-on-1 direct message thread metadata between two closers.",
      "type": "object",
      "properties": {
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "participantIds": {
          "type": "array",
          "description": "Sorted pair of 2 closer UIDs participating in this private thread."
        },
        "lastMessageText": {
          "type": "string",
          "maxLength": 500
        },
        "lastSenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "teamId",
        "participantIds",
        "lastMessageText",
        "lastSenderId",
        "lastMessageId",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private 1-on-1 message between two closers inside a DirectThread.",
      "type": "object",
      "properties": {
        "dmId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "participantIds": {
          "type": "array",
          "description": "Sorted pair of 2 closer UIDs authorized to read this private message."
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "dmId",
        "teamId",
        "participantIds",
        "senderId",
        "senderName",
        "recipientId",
        "body",
        "createdAt"
      ]
    },
    "SupervisorRecord": {
      "title": "SupervisorRecord",
      "description": "Public team-visible Supervisor status record enabling badge display and moderation permissions.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "teamId", "displayName", "active", "createdAt", "updatedAt"]
    },
    "SupervisorClaim": {
      "title": "SupervisorClaim",
      "description": "Write-only verification proof written atomically when activating Supervisor status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "syncKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "syncKey", "updatedAt"]
    },
    "SupervisorConfig": {
      "title": "SupervisorConfig",
      "description": "Non-readable server-derived syncKey verifier managed by admin for Supervisor activation.",
      "type": "object",
      "properties": {
        "syncKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["syncKey", "updatedAt"]
    },
    "FloorStats": {
      "title": "FloorStats",
      "description": "Single daily floor scoreboard document keyed by EST date (YYYY-MM-DD) tracking funnel counts and recent contributor logs.",
      "type": "object",
      "properties": {
        "dmSpoken": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "mql": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "sql": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "opportunity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "logs": {
          "type": "array",
          "description": "Up to the latest 50 log entries ({ id, metric, uid, userName, photoURL, createdAt })."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["logs", "updatedAt"]
    },
    "DailyCallStats": {
      "title": "DailyCallStats",
      "description": "Single daily RingCentral call statistics document keyed by EST date (YYYY-MM-DD).",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "teamId": {
          "type": "string",
          "enum": ["gtt-closers", "gtt-closers-9"]
        },
        "rows": {
          "type": "array",
          "description": "Up to 50 closer call stat rows ({ id, uid, name, ext, liveTalkSeconds, outbound, connected, inbound, total })."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["date", "teamId", "rows", "updatedByUid", "updatedByName", "updatedAt"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Public closer profiles including daily call counts."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Private PII records isolated per authenticated user."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/TeamPost" },
      "description": "Shared team feed of posts."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Threaded replies from closers on a shared post."
    },
    "/posts/{postId}/likes/{likeUserId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Per-user post likes synchronized atomically with post likeCount."
    },
    "/dms/{dmId}": {
      "schema": { "$ref": "#/entities/DirectThread" },
      "description": "Private 1-on-1 DM threads visible only to the two participants."
    },
    "/dms/{dmId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Private 1-on-1 messages inside a DM thread."
    },
    "/supervisors/{supervisorId}": {
      "schema": { "$ref": "#/entities/SupervisorRecord" },
      "description": "Team-visible Supervisor badge registry and Firestore moderation role."
    },
    "/supervisor_claims/{claimUid}": {
      "schema": { "$ref": "#/entities/SupervisorClaim" },
      "description": "Write-only verification proof checked atomically during Supervisor activation."
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/SupervisorConfig" },
      "description": "Write-only admin-managed Supervisor verification config."
    },
    "/floor_stats/{dateKey}": {
      "schema": { "$ref": "#/entities/FloorStats" },
      "description": "Real-time daily floor stats scoreboard keyed by EST YYYY-MM-DD."
    },
    "/daily_call_stats/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyCallStats" },
      "description": "Single daily RingCentral closer call stats document keyed by EST YYYY-MM-DD."
    }
  }
}
