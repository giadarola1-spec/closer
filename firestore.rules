rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTeamId(id) {
      return id in ['gtt-closers', 'gtt-closers-9'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'giadarola1@gmail.com'
      );
    }

    function isTeamMember() {
      return isVerified() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function isSupervisor() {
      return isVerified()
        && exists(/databases/$(database)/documents/supervisors/$(request.auth.uid))
        && get(/databases/$(database)/documents/supervisors/$(request.auth.uid)).data.active == true;
    }

    function hasValidSupervisorClaimProof(supervisorId) {
      return supervisorId == request.auth.uid
        && isTeamMember()
        && exists(/databases/$(database)/documents/app_config/supervisor)
        && existsAfter(/databases/$(database)/documents/supervisor_claims/$(supervisorId))
        && getAfter(/databases/$(database)/documents/supervisor_claims/$(supervisorId)).data.syncKey
          == get(/databases/$(database)/documents/app_config/supervisor).data.syncKey;
    }

    function isValidParticipantPair(pair) {
      return pair is list
        && pair.size() == 2
        && isValidId(pair[0])
        && isValidId(pair[1]);
    }

    // --- Validation Blueprints ---
    function isValidMember(data) {
      return data.keys().hasAll(['uid', 'teamId', 'displayName', 'focus', 'statusText', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'teamId', 'displayName', 'focus', 'statusText', 'dailyCalls', 'photoUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isValidTeamId(data.teamId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.focus is string && data.focus.size() <= 80
        && data.statusText is string && data.statusText.size() <= 140
        && (!('dailyCalls' in data) || (data.dailyCalls is int && data.dailyCalls >= 0 && data.dailyCalls <= 10000))
        && (!('photoUrl' in data) || (
          data.photoUrl is string
          && data.photoUrl.size() <= 32000
          && (
            data.photoUrl == ''
            || data.photoUrl.matches('^https://.*')
            || data.photoUrl.matches('^data:image/(jpeg|png|webp);base64,.*')
          )
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'postNotificationsEnabled', 'postSoundEnabled',
          'postSoundTone', 'postBrowserAlertsEnabled', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 200
        && (!('postNotificationsEnabled' in data) || data.postNotificationsEnabled is bool)
        && (!('postSoundEnabled' in data) || data.postSoundEnabled is bool)
        && (!('postSoundTone' in data) || data.postSoundTone in ['chime', 'ping', 'soft'])
        && (!('postBrowserAlertsEnabled' in data) || data.postBrowserAlertsEnabled is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'teamId', 'authorId', 'authorName', 'category', 'title', 'body',
          'lane', 'equipment', 'loadsPerWeek', 'stageStatus', 'pinned',
          'replyCount', 'likeCount', 'lastCommentId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'teamId', 'authorId', 'authorName', 'category', 'title', 'body', 'imageUrl',
          'lane', 'equipment', 'loadsPerWeek', 'stageStatus', 'pinned',
          'replyCount', 'likeCount', 'lastCommentId', 'createdAt', 'updatedAt'
        ])
        && isValidTeamId(data.teamId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.category in ['post', 'message', 'idea', 'mql', 'sql', 'opening']
        && data.title is string && data.title.size() <= 140
        && (!('imageUrl' in data) || data.imageUrl == null || (
          data.imageUrl is string
          && data.imageUrl.size() >= 8
          && data.imageUrl.size() <= 1000
          && data.imageUrl.matches('^https://.*')
        ))
        && data.body is string
        && data.body.size() <= 4000
        && (
          data.body.size() >= 1
          || ('imageUrl' in data && data.imageUrl is string && data.imageUrl.size() >= 8)
        )
        && data.lane is string && data.lane.size() <= 80
        && data.equipment in ['', 'Dry Van', 'Reefer', 'Both']
        && data.loadsPerWeek is string && data.loadsPerWeek.size() <= 30
        && data.stageStatus in ['open', 'in_progress', 'won', 'archived']
        && data.pinned is bool
        && data.replyCount is int && data.replyCount >= 0
        && data.likeCount is int && data.likeCount >= 0
        && data.lastCommentId is string && data.lastCommentId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['teamId', 'postId', 'authorId', 'authorName', 'body', 'createdAt'])
        && data.keys().hasOnly(['teamId', 'postId', 'authorId', 'authorName', 'body', 'createdAt'])
        && isValidTeamId(data.teamId)
        && isValidId(data.postId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidLike(data) {
      return data.keys().hasAll(['teamId', 'postId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['teamId', 'postId', 'userId', 'createdAt'])
        && isValidTeamId(data.teamId)
        && isValidId(data.postId)
        && isValidId(data.userId)
        && data.createdAt is timestamp;
    }

    function isValidDirectThread(data) {
      return data.keys().hasAll([
          'teamId', 'participantIds', 'lastMessageText', 'lastSenderId',
          'lastMessageId', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'teamId', 'participantIds', 'lastMessageText', 'lastSenderId',
          'lastMessageId', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && isValidTeamId(data.teamId)
        && isValidParticipantPair(data.participantIds)
        && data.lastMessageText is string && data.lastMessageText.size() <= 500
        && isValidId(data.lastSenderId)
        && isValidId(data.lastMessageId)
        && data.lastMessageAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll([
          'dmId', 'teamId', 'participantIds', 'senderId',
          'senderName', 'recipientId', 'body', 'createdAt'
        ])
        && data.keys().hasOnly([
          'dmId', 'teamId', 'participantIds', 'senderId',
          'senderName', 'recipientId', 'body', 'createdAt'
        ])
        && isValidId(data.dmId)
        && isValidTeamId(data.teamId)
        && isValidParticipantPair(data.participantIds)
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60
        && isValidId(data.recipientId)
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 4000
        && data.createdAt is timestamp;
    }

    function isValidSupervisorConfig(data) {
      return data.keys().hasAll(['syncKey', 'updatedAt'])
        && data.keys().hasOnly(['syncKey', 'updatedAt'])
        && data.syncKey is string
        && data.syncKey.size() == 64
        && data.syncKey.matches('^[a-f0-9]{64}$')
        && data.updatedAt is timestamp;
    }

    function isValidSupervisorClaim(data) {
      return data.keys().hasAll(['uid', 'syncKey', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'syncKey', 'updatedAt'])
        && isValidId(data.uid)
        && data.syncKey is string
        && data.syncKey.size() == 64
        && data.syncKey.matches('^[a-f0-9]{64}$')
        && data.updatedAt is timestamp;
    }

    function isValidSupervisor(data) {
      return data.keys().hasAll(['uid', 'teamId', 'displayName', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'teamId', 'displayName', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isValidTeamId(data.teamId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Admin registry (read self only; managed out-of-band)
    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Admin-managed Supervisor verification config (readable by admin only)
    match /app_config/{configId} {
      allow get: if isAdmin() && isValidId(configId) && configId == 'supervisor';
      allow list: if false;
      allow create, update: if isAdmin()
        && isValidId(configId)
        && configId == 'supervisor'
        && isValidSupervisorConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(configId) && configId == 'supervisor';
    }

    // Write-only Supervisor claim proof checked atomically on Supervisor activation
    match /supervisor_claims/{claimUid} {
      allow get, list: if false;
      allow create, update: if isVerified()
        && isValidId(claimUid)
        && claimUid == request.auth.uid
        && isTeamMember()
        && isValidSupervisorClaim(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isVerified() && isValidId(claimUid) && (claimUid == request.auth.uid || isAdmin());
    }

    // Team-visible Supervisor badge registry and moderation role
    match /supervisors/{supervisorId} {
      allow get: if isVerified() && isValidId(supervisorId) && (
        (resource == null && supervisorId == request.auth.uid) ||
        (resource != null && isValidTeamId(existing().teamId))
      );
      allow list: if isVerified() && isValidTeamId(resource.data.teamId);
      allow create: if isVerified()
        && isValidId(supervisorId)
        && isValidSupervisor(incoming())
        && incoming().uid == supervisorId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidSupervisorClaimProof(supervisorId));
      allow update: if isVerified()
        && isValidId(supervisorId)
        && isValidSupervisor(incoming())
        && incoming().uid == existing().uid
        && incoming().teamId == existing().teamId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            hasValidSupervisorClaimProof(supervisorId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'active', 'updatedAt'])
          )
        );
      allow delete: if isVerified() && isValidId(supervisorId) && (supervisorId == request.auth.uid || isAdmin());
    }

    // Private PII & personal notification settings (strict owner or admin only)
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidPrivateUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidPrivateUser(incoming())
        && (request.auth.uid == userId || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'postNotificationsEnabled',
          'postSoundEnabled',
          'postSoundTone',
          'postBrowserAlertsEnabled',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Public closers team roster profiles (no PII)
    match /members/{memberId} {
      allow get: if isVerified() && isValidId(memberId) && (
        (resource == null && memberId == request.auth.uid) ||
        (resource != null && isValidTeamId(existing().teamId))
      );
      allow list: if isVerified() && isValidTeamId(resource.data.teamId);
      allow create: if isVerified()
        && isValidId(memberId)
        && memberId == request.auth.uid
        && isValidMember(incoming())
        && 'dailyCalls' in incoming()
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(memberId)
        && isValidMember(incoming())
        && incoming().uid == existing().uid
        && isValidTeamId(incoming().teamId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (request.auth.uid == memberId || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'teamId', 'displayName', 'focus', 'statusText', 'dailyCalls', 'photoUrl', 'updatedAt'
            ])
          )
          || (
            isSupervisor()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'statusText', 'dailyCalls', 'focus', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(memberId);
    }

    // Shared team feed posts
    match /posts/{postId} {
      allow get: if isVerified() && isValidId(postId) && isValidTeamId(existing().teamId);
      allow list: if isVerified() && isValidTeamId(resource.data.teamId);
      allow create: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().replyCount == 0
        && incoming().likeCount == 0
        && incoming().lastCommentId == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTeamMember();
      allow update: if isVerified()
        && isValidId(postId)
        && isValidPost(incoming())
        && incoming().teamId == existing().teamId
        && incoming().authorId == existing().authorId
        && incoming().authorName == existing().authorName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isTeamMember() || isAdmin() || isSupervisor())
        && (
          isAdmin()
          || (
            // Action 1: Author updates content/pipeline state (blocked if archived)
            existing().authorId == request.auth.uid
            && existing().stageStatus != 'archived'
            && incoming().replyCount == existing().replyCount
            && incoming().likeCount == existing().likeCount
            && incoming().lastCommentId == existing().lastCommentId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'category', 'title', 'body', 'lane', 'equipment', 'loadsPerWeek', 'stageStatus', 'pinned', 'updatedAt'
            ])
          )
          || (
            // Action 2: Atomic comment counter increment with existsAfter verification
            isValidId(incoming().lastCommentId)
            && incoming().replyCount == existing().replyCount + 1
            && incoming().likeCount == existing().likeCount
            && incoming().diff(existing()).affectedKeys().hasOnly(['replyCount', 'lastCommentId', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(incoming().lastCommentId))
          )
          || (
            // Action 3: Atomic like creation & count increment
            incoming().likeCount == existing().likeCount + 1
            && incoming().replyCount == existing().replyCount
            && incoming().lastCommentId == existing().lastCommentId
            && incoming().diff(existing()).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
            && !exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
          )
          || (
            // Action 4: Atomic like deletion & count decrement
            existing().likeCount > 0
            && incoming().likeCount == existing().likeCount - 1
            && incoming().replyCount == existing().replyCount
            && incoming().lastCommentId == existing().lastCommentId
            && incoming().diff(existing()).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
            && exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
          )
          || (
            // Action 5: Supervisor moderation (pin/unpin or archive/reopen any post)
            isSupervisor()
            && incoming().replyCount == existing().replyCount
            && incoming().likeCount == existing().likeCount
            && incoming().lastCommentId == existing().lastCommentId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'pinned', 'stageStatus', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(postId) && (
        existing().authorId == request.auth.uid || isAdmin() || isSupervisor()
      );

      // Threaded replies
      match /comments/{commentId} {
        allow get: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidTeamId(existing().teamId)
          && exists(/databases/$(database)/documents/posts/$(postId));
        allow list: if isVerified() && isValidId(postId) && isValidTeamId(resource.data.teamId);
        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().postId == postId
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isTeamMember();
        allow update: if false;
        allow delete: if isVerified() && isValidId(postId) && isValidId(commentId) && (
          existing().authorId == request.auth.uid || isAdmin() || isSupervisor()
        );
      }

      // Per-closer post likes
      match /likes/{likeUserId} {
        allow get: if isVerified() && isValidId(postId) && isValidId(likeUserId) && (
          (resource == null && likeUserId == request.auth.uid) ||
          (resource != null && isValidTeamId(existing().teamId))
        );
        allow list: if isVerified() && isValidId(postId) && isValidTeamId(resource.data.teamId);
        allow create: if isVerified()
          && isValidId(postId)
          && isValidId(likeUserId)
          && likeUserId == request.auth.uid
          && isValidLike(incoming())
          && incoming().postId == postId
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && isTeamMember();
        allow update: if false;
        allow delete: if isVerified() && isValidId(postId) && isValidId(likeUserId) && (likeUserId == request.auth.uid || isAdmin());
      }
    }

    // Private 1-on-1 direct message threads (strictly accessible only by participants)
    match /dms/{dmId} {
      allow get: if isVerified() && isValidId(dmId) && (
        (resource == null && (
          dmId.matches('^' + request.auth.uid + '__[a-zA-Z0-9_\\-]+$') ||
          dmId.matches('^[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$')
        )) ||
        (resource != null && request.auth.uid in existing().participantIds)
      );
      allow list: if isVerified()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isVerified()
        && isValidId(dmId)
        && isValidDirectThread(incoming())
        && dmId == incoming().participantIds[0] + '__' + incoming().participantIds[1]
        && request.auth.uid in incoming().participantIds
        && incoming().lastSenderId == request.auth.uid
        && incoming().lastMessageAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isTeamMember()
        && exists(/databases/$(database)/documents/members/$(incoming().participantIds[0]))
        && exists(/databases/$(database)/documents/members/$(incoming().participantIds[1]))
        && existsAfter(/databases/$(database)/documents/dms/$(dmId)/messages/$(incoming().lastMessageId));
      allow update: if isVerified()
        && isValidId(dmId)
        && isValidDirectThread(incoming())
        && request.auth.uid in existing().participantIds
        && incoming().teamId == existing().teamId
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().lastSenderId == request.auth.uid
        && incoming().lastMessageAt == request.time
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastSenderId', 'lastMessageId', 'lastMessageAt', 'updatedAt'])
        && isTeamMember()
        && existsAfter(/databases/$(database)/documents/dms/$(dmId)/messages/$(incoming().lastMessageId));
      allow delete: if false;

      // Private messages inside the thread
      match /messages/{messageId} {
        allow get: if isVerified()
          && isValidId(dmId)
          && isValidId(messageId)
          && resource != null
          && request.auth.uid in existing().participantIds;
        allow list: if isVerified()
          && isValidId(dmId)
          && request.auth.uid in resource.data.participantIds;
        allow create: if isVerified()
          && isValidId(dmId)
          && isValidId(messageId)
          && isValidDirectMessage(incoming())
          && incoming().dmId == dmId
          && dmId == incoming().participantIds[0] + '__' + incoming().participantIds[1]
          && incoming().senderId == request.auth.uid
          && request.auth.uid in incoming().participantIds
          && incoming().recipientId in incoming().participantIds
          && incoming().createdAt == request.time
          && isTeamMember()
          && exists(/databases/$(database)/documents/members/$(incoming().recipientId))
          && existsAfter(/databases/$(database)/documents/dms/$(dmId))
          && getAfter(/databases/$(database)/documents/dms/$(dmId)).data.participantIds == incoming().participantIds
          && getAfter(/databases/$(database)/documents/dms/$(dmId)).data.lastMessageId == messageId;
        allow update: if false;
        allow delete: if isVerified()
          && isValidId(dmId)
          && isValidId(messageId)
          && resource != null
          && existing().senderId == request.auth.uid;
      }
    }

  }
}
